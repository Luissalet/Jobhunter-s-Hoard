{
  "name": "jubhunters-hoard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Contextos, fuentes y seguimiento local de candidaturas para asistentes con MCP.",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:server\" \"npm:client\"",
    "server": "node --watch server/index.js",
    "client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "mcp": "node server/mcp.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^4.21.2",
    "mammoth": "^1.12.2",
    "marked": "^15.0.6",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.17.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
